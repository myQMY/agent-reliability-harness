# 复制本文件为 .env 后填入自己的配置；.env 已被 .gitignore 忽略，切勿提交密钥
# 仅 --backend openai 时需要；默认的 ScriptedBackend 不读取任何环境变量
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 以下参数在 MVP 阶段不生效，按路线在对应阶段再启用（见 docs/mvp-design.md §7）：
# W3（预算护栏自变量）：MAX_TOKENS_PER_TASK=20000
# W5（服务化 / 并发）：EVAL_CONCURRENCY=4
# W5（外部数据库模板）：EVAL_DB_TEMPLATE=
